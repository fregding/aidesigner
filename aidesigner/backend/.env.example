# AI Designer 本地图片版默认配置
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
PUBLIC_UPLOADS_ENABLED=true
SIGNED_UPLOADS_ENABLED=false
API_BODY_LIMIT=30mb

JWT_SECRET=local-dev-jwt-secret-please-change-if-public-2026
JWT_EXPIRES_IN=7d
CONFIG_ENCRYPTION_KEY=local-dev-config-secret-please-change-if-public-2026

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=AdminLocal@2026
LOCAL_RESET_ADMIN_PASSWORD=true
LOCAL_IMAGE_ONLY_MODE=true
LOCAL_FULL_CREDITS=999999999
LOCAL_IMAGE_MAX_SIZE=512

ENABLE_IMAGE=true
ENABLE_PPT=false
ENABLE_VIDEO=false
ENABLE_PAYMENTS=false
ENABLE_ASSISTANT=false

DATA_DIR=./data
DB_PATH=./data/aimaster.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 本机图片模型服务，启动 local-image-server 后可用
IMAGE_BASE_URL=http://127.0.0.1:18080/v1
IMAGE_API_KEY=local-ai-dev-key
IMAGE_MODEL=local-sd15-openvino
IMAGE_QUALITY=low
IMAGE_OUTPUT_FORMAT=png
IMAGE_TIMEOUT_MS=1800000
IMAGE_FAILOVER_ENABLED=false
IMAGE_FALLBACK_BASE_URL=
IMAGE_FALLBACK_API_KEY=

# 关闭外部文本/搜索/支付
TIME_BACKWARD_BASE_URL=http://127.0.0.1:18080/v1
TIME_BACKWARD_API_KEY=
CHAT_MODEL=disabled
ASSISTANT_MODEL=disabled
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
TAVILY_BASE_URL=
SITE_RECHARGE_MODE=card_link
SITE_PURCHASE_CARD_URL=
ALIPAY_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
REGISTRATION_INITIAL_CREDITS=999999999

# PPT/Office 本地图片版默认关闭
PPT_GENERATE_IMAGES=false
PPT_MAX_PAGES=1
OFFICE_PREVIEW_AUTO_RENDER=false
UNOSERVER_ENABLED=false
