LOCAL_IMAGE_HOST=127.0.0.1
LOCAL_IMAGE_PORT=18080
LOCAL_IMAGE_API_KEY=local-ai-dev-key
LOCAL_IMAGE_BACKEND=openvino
LOCAL_IMAGE_MODEL_ID=OpenVINO/stable-diffusion-v1-5-int8-ov
LOCAL_IMAGE_DEVICE=CPU
LOCAL_IMAGE_CACHE_DIR=../runtime/hf-cache
LOCAL_IMAGE_OUTPUT_DIR=../runtime/generated
LOCAL_IMAGE_MAX_SIZE=512
LOCAL_IMAGE_STEPS=12
LOCAL_IMAGE_GUIDANCE_SCALE=7.0
LOCAL_IMAGE_SEED=
# 设置为 1 可允许首次运行自动从 Hugging Face 下载；设置为 0 时缺模型会直接报错并提示手动下载。
LOCAL_IMAGE_ALLOW_DOWNLOAD=1
