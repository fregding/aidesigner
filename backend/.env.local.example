PORT=3000
NODE_ENV=development
TRUST_PROXY=false
PUBLIC_UPLOADS_ENABLED=true
SIGNED_UPLOADS_ENABLED=false
DATA_DIR=./data
DB_PATH=./data/aimaster.db
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=AdminLocal@2026
JWT_SECRET=local-dev-jwt-secret-change-before-production-1234567890
CONFIG_ENCRYPTION_KEY=local-dev-config-key-change-before-production-1234567890

ENABLE_LOCAL_IMAGE=false
IMAGE_PROVIDER=local-openvino
IMAGE_BASE_URL=http://127.0.0.1:18081/v1
IMAGE_API_KEY=local-dev-key
IMAGE_MODEL=sd-turbo-openvino
IMAGE_QUALITY=standard
IMAGE_OUTPUT_FORMAT=png
IMAGE_TIMEOUT_MS=600000

# Local PPT/text server uses 18082 so it does not conflict with OpenVINO image server on 18081.
PPT_PROVIDER=local
ENABLE_LOCAL_PPT=true
LOCAL_TEXT_API_BASE_URL=http://127.0.0.1:18082/v1
LOCAL_TEXT_API_KEY=local-dev-key
LOCAL_TEXT_MODEL=local-text-mock
provider_base_url=http://127.0.0.1:18082/v1
provider_api_key=local-dev-key
TIME_BACKWARD_BASE_URL=http://127.0.0.1:18082/v1
TIME_BACKWARD_API_KEY=local-dev-key
CHAT_MODEL=local-text-mock
PPT_MODEL=local-text-mock
PPT_MASTER_ROOT=../external/ppt-master
PPT_MASTER_PYTHON=../external/ppt-master/venv/Scripts/python.exe
PPT_GENERATE_IMAGES=true
PPT_IMAGE_CONCURRENCY=1
PPT_IMAGE_VARIANTS_PER_REQUEST=1

ANTHROPIC_API_KEY=local-dev-placeholder

EMAIL_DEV_LOG_CODES=true
ALIPAY_ENABLED=false
OFFICE_PREVIEW_AUTO_RENDER=false
UNOSERVER_ENABLED=false
IMAGE_BASE_URL=
IMAGE_API_KEY=

# To use a real image model/API, run configure_real_image_api.bat or set:
# ENABLE_LOCAL_IMAGE=false
# IMAGE_PROVIDER=openai-compatible
# IMAGE_BASE_URL=https://your-provider.example/v1
# IMAGE_API_KEY=your-api-key
# IMAGE_MODEL=gpt-image-1
