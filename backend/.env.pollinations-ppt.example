# Pollinations Text API for PPT generation only.
# Copy these values into backend\.env.local, or run scripts\use_pollinations_ppt_api.bat.

ENABLE_PPT=true
DISABLE_PPT=false
PPT_PROVIDER=openai-compatible
ENABLE_LOCAL_PPT=false

TIME_BACKWARD_BASE_URL=https://gen.pollinations.ai/v1
TIME_BACKWARD_API_KEY=none

CHAT_MODEL=openai
ASSISTANT_MODEL=openai
PPT_MODEL=openai

PPT_MASTER_ROOT=../external/ppt-master
PPT_MASTER_PYTHON=../external/ppt-master/venv/Scripts/python.exe
PPT_GENERATE_IMAGES=false
PPT_MAX_PAGES=6
PPT_TIMEOUT_MS=900000
