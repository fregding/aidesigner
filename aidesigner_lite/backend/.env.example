# 服务器配置
PORT=3000
NODE_ENV=production
TRUST_PROXY=true
PUBLIC_UPLOADS_ENABLED=false
SIGNED_UPLOADS_ENABLED=true
API_BODY_LIMIT=10mb
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=120
RATE_LIMIT_PROXY_MAX=90
RATE_LIMIT_EXPENSIVE_MAX=60

# JWT配置
JWT_SECRET=replace-with-64-random-characters
JWT_EXPIRES_IN=7d
CONFIG_ENCRYPTION_KEY=replace-with-64-random-characters

# 管理员账号由部署脚本生成或部署时注入
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-generated-password

# 邮箱验证码。开发环境不配置 SMTP 时，验证码会输出到后端控制台日志。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Designer <no-reply@example.com>"
EMAIL_DEV_LOG_CODES=false
EMAIL_SEND_INTERVAL_MS=1500
EMAIL_SEND_QUEUE_MAX=100
EMAIL_SEND_QUEUE_TIMEOUT_MS=120000
EMAIL_SMTP_MAX_CONNECTIONS=1
EMAIL_SMTP_MAX_MESSAGES=100
EMAIL_SMTP_RATE_DELTA_MS=1000
EMAIL_SMTP_RATE_LIMIT=1
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_HOURLY_LIMIT=5

# 数据库配置
DATA_DIR=./data
DB_PATH=./data/aimaster.db

# AI API配置 (根据实际使用的AI服务填写)
# Claude/Anthropic-compatible relay (llmapi.pro)
TIME_BACKWARD_BASE_URL=https://llmapi.pro
TIME_BACKWARD_API_KEY=your-relay-api-key
CHAT_MODEL=claude-sonnet-4-6
ASSISTANT_MODEL=claude-sonnet-4-6

# Image generation OpenAI-compatible endpoint
IMAGE_BASE_URL=https://timebackward.com/v1
IMAGE_API_KEY=your-image-api-key
IMAGE_ASSISTANT_BASE_URL=https://timebackward.com/v1
IMAGE_ASSISTANT_API_KEY=your-image-api-key
IMAGE_ASSISTANT_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high
IMAGE_OUTPUT_FORMAT=png
IMAGE_TIMEOUT_MS=600000

# Video generation. For VectorEngine Kling relay, use a provider profile in
# TEXT_PROVIDER_PROFILES with format "kling", baseUrl "https://api.vectorengine.ai",
# then set VIDEO_PROVIDER_ID to that provider id.
VIDEO_PROVIDER_ID=
VIDEO_MODEL=kling-v3

# Claude (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Tavily 搜索
TAVILY_API_KEY=your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com

# 支付宝充值。也可以在后台“设置 -> 支付充值”中配置，私钥会加密保存。
SITE_RECHARGE_MODE=alipay
SITE_PURCHASE_CARD_URL=
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_RETURN_URL=
ALIPAY_NOTIFY_URL=

# PPT Agent / PPT Master
PPT_MODEL=claude-opus-4-7
PPT_MASTER_ROOT=../external/ppt-master
PPT_MASTER_PYTHON=../external/ppt-master/venv/bin/python
PPT_GENERATE_IMAGES=true
PPT_MAX_PAGES=15

# 价格设置
PRICING_AI_TOKEN_CREDITS_PER_1K=0.1

# Office/PPT 上传预览缓存。上传 PPT 后后台自动转 PDF 再切 PNG，
# PNG 仅作为后端缓存/AI 视觉上下文，不会单独展示成文件。
# 推荐：pip install unoserver && unoserver --daemon
OFFICE_PREVIEW_AUTO_RENDER=true
OFFICE_PREVIEW_PAGE_LIMIT=24
UNOSERVER_ENABLED=true
UNOSERVER_HOST=127.0.0.1
UNOSERVER_PORT=2003
UNOSERVER_HOST_LOCATION=local
UNOCONVERT_BIN=unoconvert
UNOPING_BIN=unoping

# 文件存储配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# CORS配置
ALLOWED_ORIGINS=https://your-domain.example
