PORT=3000
NODE_ENV=development
TRUST_PROXY=false
PUBLIC_UPLOADS_ENABLED=true
SIGNED_UPLOADS_ENABLED=false
DATA_DIR=./data
DB_PATH=./data/aimaster.db
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=AdminLocal@2026
JWT_SECRET=local-dev-jwt-secret-change-before-production-1234567890
CONFIG_ENCRYPTION_KEY=local-dev-config-key-change-before-production-1234567890

ENABLE_LOCAL_IMAGE=true
IMAGE_PROVIDER=mock
LOCAL_IMAGE_API_BASE_URL=http://127.0.0.1:18080/v1
LOCAL_IMAGE_API_KEY=local-dev-key
LOCAL_IMAGE_MODEL=local-cpu-safe-image
IMAGE_MODEL=local-cpu-safe-image
IMAGE_TIMEOUT_MS=600000

TIME_BACKWARD_API_KEY=local-dev-placeholder
ANTHROPIC_API_KEY=local-dev-placeholder

EMAIL_DEV_LOG_CODES=true
ALIPAY_ENABLED=false
OFFICE_PREVIEW_AUTO_RENDER=false
UNOSERVER_ENABLED=false
IMAGE_BASE_URL=
IMAGE_API_KEY=

# To use a real image model/API, run configure_real_image_api.bat or set:
# ENABLE_LOCAL_IMAGE=false
# IMAGE_PROVIDER=openai-compatible
# IMAGE_BASE_URL=https://your-provider.example/v1
# IMAGE_API_KEY=your-api-key
# IMAGE_MODEL=gpt-image-1
