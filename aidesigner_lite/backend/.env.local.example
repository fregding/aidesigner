# AI Designer Lite local Windows/macOS/Linux development config
# Used by start_all.bat and scripts/dev.sh. Docker continues to use .env.docker.

PORT=3000
NODE_ENV=development
TRUST_PROXY=false
PUBLIC_UPLOADS_ENABLED=true
SIGNED_UPLOADS_ENABLED=false
API_BODY_LIMIT=30mb
RATE_LIMIT_ENABLED=false

JWT_SECRET=aimaster-local-development-secret-change-me-please-2026
JWT_EXPIRES_IN=7d
CONFIG_ENCRYPTION_KEY=aimaster-local-config-secret-change-me-2026

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=AdminLocal@2026

DATA_DIR=./data
DB_PATH=./data/aimaster.db
UPLOAD_DIR=./uploads
FRONTEND_ROOT=..

# Local browser origins. This fixes the no-domain/localhost .bat startup problem.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000
SITE_PUBLIC_BASE_URL=http://localhost:3000

# Local mock image server started by start_all.bat/scripts/dev.sh.
ENABLE_LOCAL_IMAGE=true
IMAGE_PROVIDER=local
LOCAL_IMAGE_API_BASE_URL=http://127.0.0.1:18080/v1
LOCAL_IMAGE_API_KEY=local-dev-key
LOCAL_IMAGE_MODEL=local-mock-image
IMAGE_BASE_URL=http://127.0.0.1:18080/v1
IMAGE_API_KEY=local-dev-key
IMAGE_MODEL=local-mock-image
IMAGE_ASSISTANT_BASE_URL=http://127.0.0.1:18080/v1
IMAGE_ASSISTANT_API_KEY=local-dev-key
IMAGE_ASSISTANT_MODEL=local-mock-image
IMAGE_FAILOVER_ENABLED=false
IMAGE_TIMEOUT_MS=600000

# Lite local mode: keep optional paid/heavy modules off by default.
ENABLE_PPT=false
ENABLE_VIDEO=false
ENABLE_PAYMENT=false
ENABLE_PAYMENTS=false
ENABLE_MEMBERSHIP=false
ENABLE_ALIPAY=false
ENABLE_ASSISTANT=false
DISABLE_PPT=true
DISABLE_VIDEO=true
DISABLE_PAYMENTS=true
DISABLE_MEMBERSHIP=true

# Text providers are intentionally blank for local image-only testing.
TIME_BACKWARD_BASE_URL=https://llmapi.pro
TIME_BACKWARD_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
ASSISTANT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Designer <no-reply@localhost>"
EMAIL_DEV_LOG_CODES=true

ALIPAY_ENABLED=false
SITE_RECHARGE_MODE=alipay
SITE_PURCHASE_CARD_URL=
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_RETURN_URL=
ALIPAY_NOTIFY_URL=

OFFICE_PREVIEW_AUTO_RENDER=false
UNOSERVER_ENABLED=false
