# Docker Compose interpolation
APP_BIND=127.0.0.1
APP_PORT=3000
APP_UID=1000
APP_GID=1000

# Runtime
NODE_ENV=production
TRUST_PROXY=true
PUBLIC_UPLOADS_ENABLED=false
SIGNED_UPLOADS_ENABLED=true
ALLOWED_ORIGINS=https://your-domain.example
API_BODY_LIMIT=10mb
MAX_FILE_SIZE=52428800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=120
RATE_LIMIT_PROXY_MAX=90
RATE_LIMIT_EXPENSIVE_MAX=60

# Generated by scripts/deploy-docker.sh or scripts/local-docker.sh
JWT_SECRET=replace-with-generated-secret
CONFIG_ENCRYPTION_KEY=replace-with-generated-secret
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-generated-password
JWT_EXPIRES_IN=7d

# Email verification for registration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Designer <no-reply@your-domain.example>"
EMAIL_DEV_LOG_CODES=false
EMAIL_SEND_INTERVAL_MS=1500
EMAIL_SEND_QUEUE_MAX=100
EMAIL_SEND_QUEUE_TIMEOUT_MS=120000
EMAIL_SMTP_MAX_CONNECTIONS=1
EMAIL_SMTP_MAX_MESSAGES=100
EMAIL_SMTP_RATE_DELTA_MS=1000
EMAIL_SMTP_RATE_LIMIT=1
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_HOURLY_LIMIT=5

# AI providers can also be configured later in the admin UI.
TIME_BACKWARD_BASE_URL=https://llmapi.pro
TIME_BACKWARD_API_KEY=
CHAT_MODEL=claude-opus-4-7
ASSISTANT_MODEL=claude-opus-4-7

IMAGE_BASE_URL=https://timebackward.com/v1
IMAGE_API_KEY=
IMAGE_ASSISTANT_BASE_URL=https://timebackward.com/v1
IMAGE_ASSISTANT_API_KEY=
IMAGE_ASSISTANT_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low
IMAGE_OUTPUT_FORMAT=png
IMAGE_TIMEOUT_MS=600000
VIDEO_PROVIDER_ID=
VIDEO_MODEL=kling-v3

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Recharge and payment can also be configured later in the admin UI.
SITE_RECHARGE_MODE=alipay
SITE_PURCHASE_CARD_URL=
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_RETURN_URL=
ALIPAY_NOTIFY_URL=

PPT_GENERATE_IMAGES=true
PPT_MAX_PAGES=15
